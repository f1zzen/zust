{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zust",
  "version": "../package.json",
  "identifier": "com.f1zzen.zust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zust",
        "label": "main",
        "width": 600,
        "height": 700,
        "minHeight": 700,
        "minWidth": 600,
        "transparent": true,
        "decorations": false,
        "visible": false
      },
      {
        "title": "Zust",
        "label": "splash",
        "url": "splash.html",
        "width": 320,
        "height": 450,
        "decorations": false,
        "center": true,
        "resizable": false,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Простой интерфейс для обхода блокировок"
  }
}