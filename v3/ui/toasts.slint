// Всплывающие уведомления внизу окна. Список ведёт Rust (backend/notify.rs).

import { Theme } from "theme.slint";
import { Icons, Icon } from "components.slint";
import { Backend, Toast } from "globals.slint";

component ToastItem inherits Rectangle {
    in property <Toast> data;
    property <bool> visible-now: data.shown;
    property <color> tint: data.kind == 2 ? Theme.error : data.kind == 1 ? Theme.success : Theme.primary;

    height: row.preferred-height;
    border-radius: Theme.radius-m;
    background: Theme.classic ? #121218 : Theme.surface-high;
    border-width: 1px;
    border-color: data.kind == 2 ? Theme.error.transparentize(50%)
        : Theme.classic ? #ffffff14 : Theme.outline;
    drop-shadow-blur: Theme.lite ? 0px : 20px;
    drop-shadow-color: #00000050;
    opacity: visible-now ? 1 : 0;
    transform-scale: visible-now || !Theme.motion ? 1 : 0.94;
    animate opacity { duration: Theme.motion ? 300ms : 0ms; easing: ease-out; }
    animate transform-scale { duration: Theme.motion ? 320ms : 0ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Backend.toast-close(data.id); }
    }
    row := HorizontalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: data.kind == 2 ? Icons.alert : data.kind == 1 ? Icons.check : Icons.info;
                color: tint;
                width: 20px;
                height: 20px;
            }
        }
        Text {
            text: data.text;
            color: Theme.on-surface;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                name: Icons.close;
                color: Theme.on-surface-variant;
                width: 16px;
                height: 16px;
                opacity: ta.has-hover ? 1 : 0;
                animate opacity { duration: Theme.fast; }
            }
        }
    }
}

export component Toasts inherits Rectangle {
    VerticalLayout {
        alignment: end;
        spacing: 8px;
        for t in Backend.toasts: ToastItem { data: t; }
    }
}
